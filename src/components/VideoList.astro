---
// 影片縮圖格狀：桌機 3 欄、中間寬度 2 欄、48rem 以下 1 欄。點縮圖才載入播放器，播放時該卡佔整列寬。
import VideoCard from './VideoCard.astro';
import { videoAnchor, videosOf, type Series } from '../lib/videos';
import { url } from '../lib/url';
const { slug = 'pcb-si', series = 'tool-guide', latest } = Astro.props as { slug?: string; series?: Series; latest?: number };
// latest：首頁「最新影片」，取集數最大的幾支，連到影片頁該集。
const all = videosOf(slug, series);
// 施工中（construction）的影片：影片頁顯示施工中卡片，首頁最新影片不列。
const entries = latest ? all.filter((v) => v.episode > 0 && !v.construction).reverse().slice(0, latest) : all;
const page = url(`/tools/${slug}/videos/`);
---
{entries.length ? (
  <div class="video-grid not-content">
    {entries.map((v) => <VideoCard video={v} href={latest ? `${page}#${videoAnchor(v)}` : undefined} />)}
  </div>
) : <p>No verified public videos listed yet. · 尚未列入已核對的公開影片。</p>}

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-play').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = button.closest<HTMLElement>('.video-thumb');
      const card = button.closest<HTMLElement>('.video-card');
      if (!frame || !card || !/^[\w-]{11}$/.test(frame.dataset.videoId ?? '')) return;
      const iframe = document.createElement('iframe');
      const src = new URL(`https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}`);
      src.searchParams.set('autoplay', '1');
      src.searchParams.set('playsinline', '1');
      iframe.src = src.href;
      iframe.title = frame.dataset.videoTitle ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      card.classList.add('is-playing');
      card.querySelector<HTMLElement>('.video-guide')?.removeAttribute('hidden');
      frame.replaceChildren(iframe);
      iframe.focus();
      card.scrollIntoView({ block: 'nearest' });
    });
  });
</script>

<style>
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem 1rem; max-width: 960px; margin-block: 1.5rem 2rem; }
  @media (max-width: 64rem) { .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 48rem) { .video-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
