---
import videos from '../data/videos.json';
const { slug = 'pcb-si' } = Astro.props;
const entries = videos.filter(v => v.tool === slug);
---
{entries.length ? <div class="videos">{entries.map(v => <article>
 <h2>{v.title}</h2><p class="zh" lang="zh-Hant">{v.titleZh}</p>
 <div class="video-frame" data-video-id={v.youtubeId} data-video-title={`${v.titleZh} · ${v.title}`}>
 <button class="video-play" type="button" aria-label={`播放${v.titleZh} · Play ${v.title}`}>
  <span class="play-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M7 4v16l14-8z" fill="currentColor" /></svg></span>
  <strong>播放影片 · Play video</strong>
  <span class="video-caption">{v.titleZh}</span>
  <span class="video-privacy">點擊後載入 YouTube 播放器</span>
 </button>
 </div>
 <p><a href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>Watch on YouTube · 在 YouTube 觀看</a></p>
 </article>)}</div> : <p>No verified public videos listed yet. · 尚未列入已核對的公開影片。</p>}
<script>
 document.querySelectorAll<HTMLButtonElement>('.video-play').forEach(button => {
  button.addEventListener('click', () => {
   const frame = button.closest<HTMLElement>('.video-frame');
   if (!frame || !/^[\w-]{11}$/.test(frame.dataset.videoId ?? '')) return;
   const iframe = document.createElement('iframe');
   const url = new URL(`https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}`);
   url.searchParams.set('autoplay', '1');
   url.searchParams.set('playsinline', '1');
   iframe.src = url.href;
   iframe.title = frame.dataset.videoTitle ?? 'YouTube video';
   iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
   iframe.allowFullscreen = true;
   iframe.referrerPolicy = 'strict-origin-when-cross-origin';
   frame.replaceChildren(iframe);
   iframe.focus();
  });
 });
</script>
<style>
 .video-frame { aspect-ratio: 16 / 9; min-height: 200px; background: var(--sl-color-gray-6); display: grid; place-items: center; overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; }
 .video-frame :global(iframe) { width: 100%; height: 100%; border: 0; }
 .video-play { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .7rem; padding: 1.25rem; border: 0; font: inherit; background: var(--sl-color-gray-6); color: var(--sl-color-white); cursor: pointer; }
 .video-play:hover { background: var(--sl-color-gray-5); }
 .video-play:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: -5px; }
 .play-symbol { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; padding-inline-start: .15rem; border-radius: 50%; background: var(--sl-color-text-accent); color: var(--sl-color-black); font-size: 1.35rem; }
 .video-caption { font-size: .95rem; }
 .video-privacy { color: var(--sl-color-gray-2); font-size: .8rem; }
 article { margin-block: 2rem; }
</style>
