---
import videos from '../data/videos.json';
const { slug = 'pcb-si' } = Astro.props;
const entries = videos.filter(v => v.tool === slug);
---
{entries.length ? <div class="videos">{entries.map(v => <article>
 <h2>{v.title}</h2><p class="zh" lang="zh-Hant">{v.titleZh}</p>
 <div class="video-frame" data-video-id={v.youtubeId} data-video-title={v.title}>
 <button class="button video-play" type="button" aria-label={`Play ${v.title} · 播放${v.titleZh}`}>Play video · 播放影片</button>
 </div>
 <p><a href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>Watch on YouTube · 在 YouTube 觀看</a></p>
 </article>)}</div> : <p>No verified public videos listed yet. · 尚未列入已核對的公開影片。</p>}
<script>
 document.querySelectorAll<HTMLButtonElement>('.video-play').forEach(button => {
  button.addEventListener('click', () => {
   const frame = button.closest<HTMLElement>('.video-frame');
   if (!frame || !/^[\w-]{11}$/.test(frame.dataset.videoId ?? '')) return;
   const iframe = document.createElement('iframe');
   iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}?autoplay=1`;
   iframe.title = frame.dataset.videoTitle ?? 'YouTube video';
   iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
   iframe.allowFullscreen = true;
   iframe.referrerPolicy = 'strict-origin-when-cross-origin';
   frame.replaceChildren(iframe);
   iframe.focus();
  });
 });
</script>
<style>
 .video-frame { aspect-ratio: 16 / 9; background: var(--sl-color-gray-6); display: grid; place-items: center; }
 .video-frame :global(iframe) { width: 100%; height: 100%; border: 0; }
 .video-play { background: var(--sl-color-gray-6); color: var(--sl-color-white); cursor: pointer; }
 article { margin-block: 2rem; }
</style>
