---
// 工具真實截圖的局部特寫，加上簡單的桌面視窗外框；點圖開啟未裁切的原圖。
import { appIcon } from '../lib/pcbsi';
import { url } from '../lib/url';
const { file, source, width, height, alt, caption, zh, title = 'PCB SI 3D Simulation Toolkit', eager = false, maxWidth = 960 } = Astro.props as {
  file: string; source: string; width: number; height: number; alt: string; caption: string; zh: string; title?: string; eager?: boolean; maxWidth?: number;
};
const icon = appIcon.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<figure class="window-shot" style={`max-width:${maxWidth}px`}>
  <div class="ws-frame">
    <div class="ws-bar" aria-hidden="true">
      <span class="ws-icon" set:html={icon} />
      <span class="ws-title">{title}</span>
      <svg class="ws-controls" viewBox="0 0 84 12" width="84" height="12">
        <path d="M2 6h10M37 1h10v10H37zM72 1l10 10M82 1 72 11" fill="none" stroke="currentColor" stroke-width="1" />
      </svg>
    </div>
    <a href={url(`/manual/pcb-si/${source}`)} aria-label={`Open the full screenshot · 開啟完整截圖：${alt}`}>
      <img src={url(`/manual/pcb-si/${file}`)} width={width} height={height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </a>
  </div>
  <figcaption>{caption}<br /><span lang="zh-Hant">{zh}</span></figcaption>
</figure>
<style>
  .window-shot { margin-block: 1.5rem 2rem; max-width: 960px; }
  .ws-frame {
    border: 1px solid #2c4a66;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #0f1b2d;
  }
  .ws-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding-inline: 0.625rem 0.75rem;
    border-bottom: 1px solid #2c4a66;
    color: #c6d4e2;
    font-size: 0.8125rem;
    line-height: 1;
  }
  .ws-icon { display: block; width: 16px; height: 16px; }
  .ws-icon :global(svg) { display: block; width: 100%; height: 100%; }
  .ws-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ws-controls { flex: 0 0 auto; color: #8ea3b8; }
  .ws-frame a { display: block; }
  .ws-frame img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 0.5rem; color: var(--sl-color-gray-2); font-size: 0.9375rem; line-height: 1.6; }
  @media (max-width: 30rem) { .ws-controls { width: 60px; } }
</style>
