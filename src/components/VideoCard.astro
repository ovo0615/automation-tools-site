---
// 影片縮圖卡：縮圖、集別（只有流程示範）、中英主題、長度。
// 影片頁（沒有 href）點縮圖才在原地載入 youtube-nocookie 播放器；首頁（有 href）整張卡連到影片頁該集。
import { url } from '../lib/url';
import { shownLabel, videoAnchor, type Video } from '../lib/videos';
const { video: v, href } = Astro.props as { video: Video; href?: string };
const label = shownLabel(v);
const name = [label, v.titleZh].filter(Boolean).join(' ');
const meta = [label, v.duration].filter(Boolean).join(' · ');
const thumb = url(`/video-thumbs/${v.youtubeId}.webp`);
---
{href ? (
  <a class="video-card video-link" href={href}>
    <span class="video-thumb"><img src={thumb} width="960" height="540" alt="" loading="lazy" decoding="async" /></span>
    <span class="video-meta">{meta}</span>
    <span class="video-zh">{v.titleZh}</span>
    <span class="video-en" lang="en">{v.titleEn}</span>
  </a>
) : (
  <article class="video-card" id={videoAnchor(v)}>
    <div class="video-thumb" data-video-id={v.youtubeId} data-video-title={v.title}>
      <button class="video-play" type="button" aria-label={`播放 ${name}`}>
        <img src={thumb} width="960" height="540" alt="" loading="lazy" decoding="async" />
        <span class="play-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M7 4v16l14-8z" fill="currentColor" /></svg></span>
      </button>
    </div>
    <p class="video-meta">{meta}</p>
    <h3 class="video-zh">{v.titleZh}</h3>
    <p class="video-en" lang="en">{v.titleEn}</p>
    <p class="video-more">
      <a href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>在 YouTube 觀看</a>
      {v.guide?.length ? (
        <span class="video-guide" hidden>
          對應說明：{v.guide.map((g, i) => <Fragment>{i > 0 ? '、' : ''}<a href={url(g.path)}>{g.label}</a></Fragment>)}
        </span>
      ) : null}
    </p>
  </article>
)}

<style>
  .video-card { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; margin: 0; scroll-margin-top: calc(var(--sl-nav-height) + 1rem); }
  .video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--site-radius);
    background: #111;
  }
  .video-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video-thumb :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .video-play { position: absolute; inset: 0; display: grid; place-items: center; padding: 0; border: 0; font: inherit; background: none; cursor: pointer; }
  .video-play img { position: absolute; inset: 0; }
  .video-play:hover img, .video-link:hover img { filter: brightness(0.85); }
  .video-play:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: -5px; }
  .play-symbol {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding-inline-start: 0.15rem;
    border-radius: 50%;
    background: #e62117;
    color: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.35);
  }
  .video-meta { margin: 0; color: var(--sl-color-gray-3); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .video-zh { margin: 0; color: var(--sl-color-white); font-size: 1.0625rem; font-weight: 650; line-height: 1.4; }
  .video-en { margin: 0; color: var(--sl-color-gray-3); font-size: 0.9375rem; line-height: 1.4; }
  .video-more { display: flex; flex-wrap: wrap; gap: 0 1rem; margin: 0.25rem 0 0; font-size: 0.875rem; }
  .video-more a { display: inline-flex; align-items: center; min-height: 44px; }
  .video-guide { color: var(--sl-color-gray-3); }
  /* 播放時佔整列寬，並顯示對應的操作說明章節 */
  .video-card.is-playing { grid-column: 1 / -1; }
  .video-card.is-playing .video-zh { font-size: 1.25rem; }
  .video-card:target .video-thumb { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  .video-link { color: inherit; text-decoration: none; }
  .video-link .video-zh { color: var(--sl-color-accent-high); text-decoration: underline; text-underline-offset: 0.2em; }
  .video-link:hover .video-zh { color: var(--sl-color-white); }
</style>
