---
// 首頁「我想要…」任務入口：六張卡，標題連到該頁，下方條列直達章節；左側導覽不變。觸控目標至少 44px。
// 2026-10-28 Jeff：卡片放大、不放圖片、改條列式。
import { url } from '../lib/url';
import { videosOf } from '../lib/videos';

type Item = { label: string; to: string };
type Task = { zh: string; to: string; items: Item[] };
const quick = '/tools/pcb-si/quick-start/';
const manual = '/tools/pcb-si/manual/';
const faq = '/tools/pcb-si/faq/';
const videos = '/tools/pcb-si/videos/';
const tasks: Task[] = [
  {
    zh: '申請試用與安裝',
    to: '/trial/',
    items: [
      { label: '填試用申請', to: '/trial/' },
      { label: '安裝與核對安裝包', to: `${quick}#1-install--安裝` },
      { label: '匯出授權申請檔', to: `${quick}#4-export-a-request--匯出授權申請檔` },
      { label: '匯入授權檔', to: `${quick}#5-import-the-licence--匯入授權檔` },
    ],
  },
  {
    zh: '第一次跑通',
    to: manual,
    items: [
      { label: '載入內附範例板', to: `${manual}#1-load-a-board--載入電路板` },
      { label: '選擇網路', to: `${manual}#2-select-nets--選擇網路` },
      { label: '建立 Port', to: `${manual}#5-create-ports--建立-port` },
      { label: '一鍵 HTML 報告', to: `${manual}#12-html-report--一鍵-html-報告` },
    ],
  },
  {
    zh: '查某個步驟',
    to: manual,
    items: [
      { label: '預覽與裁切', to: `${manual}#3-preview-and-cut--預覽與裁切` },
      { label: 'Port 與頻率', to: `${manual}#4-ports-and-frequency--port-與頻率` },
      { label: '分段', to: `${manual}#6-segment-the-channel--分段` },
      { label: '電路串接', to: `${manual}#8-cascade--電路串接` },
      { label: 'TDR 阻抗定位（施工中）', to: `${manual}#11-tdr--tdr-阻抗定位` },
      { label: 'HTML 報告', to: `${manual}#12-html-report--一鍵-html-報告` },
    ],
  },
  {
    zh: '看操作影片',
    to: videos,
    items: [
      { label: '功能總覽', to: `${videos}#overview` },
      { label: `工具操作教學（${videosOf('pcb-si', 'tool-guide').length} 支）`, to: `${videos}#tool-tutorials--工具操作教學` },
      { label: `AI Agent 工程流程示範（${videosOf('pcb-si', 'agent-workflow').length} 支）`, to: `${videos}#ai-agent-workflow-demonstrations--ai-agent-工程流程示範` },
    ],
  },
  {
    zh: '遇到問題',
    to: faq,
    items: [
      { label: '安裝與執行', to: `${faq}#installation--runtime--安裝與執行` },
      { label: '授權與求解', to: `${faq}#licences--solving--授權與求解` },
      { label: '已知問題', to: `${faq}#known-issues--已知問題` },
      { label: '回報 Bug', to: '/tools/pcb-si/bugs/' },
    ],
  },
  {
    zh: '看更新了什麼',
    to: '/tools/pcb-si/changelog/',
    items: [
      { label: '目前版本', to: '/tools/pcb-si/changelog/' },
      { label: '已發布版本', to: '/tools/pcb-si/changelog/#published-releases--已發布版本' },
    ],
  },
];
---
<ul class="tasks not-content" aria-label="我想要…">
  {tasks.map((t) => (
    <li class="task">
      <a class="task-title" href={url(t.to)}>{t.zh}</a>
      <ul class="task-items">
        {t.items.map((m) => <li><a href={url(m.to)}>{m.label}</a></li>)}
      </ul>
    </li>
  ))}
</ul>

<style>
  .tasks {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 960px;
    margin: 1rem 0 0;
    padding: 0;
  }
  /* 內文清單的 72ch 上限不適用：任務卡與主欄同寬。 */
  :global(.sl-markdown-content) > .tasks { max-width: 960px; }
  .task {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 1.25rem 1.5rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--site-radius);
    background: var(--sl-color-gray-7);
  }
  .task:hover { border-color: var(--sl-color-accent-high); }
  .task-title {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--sl-color-accent-high);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .task-title:hover { color: var(--sl-color-white); }
  .task-items {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--sl-color-gray-3);
    font-size: 1rem;
  }
  .task-items li { margin: 0; }
  .task-items a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 48rem) { .tasks { grid-template-columns: minmax(0, 1fr); } }
</style>
