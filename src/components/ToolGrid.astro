---
import { toolList, toolData } from '../lib/data';
import { url } from '../lib/url';
---

<div class="tool-grid not-content">
  {
    toolList.map((t) => (
      <article class:list={['tool-card', t.status]}>
        <span class:list={['badge-status', t.status]}>
          {t.status === 'available' ? 'Available · 已推出' : 'Coming soon · 即將推出'}
        </span>
        <h3>
          {t.status === 'available' ? <a href={url(`/tools/${t.slug}/`)}>{t.name}</a> : t.name}
        </h3>
        <p class="zh-name">{t.nameZh}</p>
        <p>{t.summary}</p>
        <p class="zh">{t.summaryZh}</p>
        {toolData(t.slug)?.sections[0] && (
          <p class="latest">
            Latest · 最新版本：<a href={url(`/tools/${t.slug}/changelog/`)}>{toolData(t.slug)!.sections[0].version}</a>
          </p>
        )}
      </article>
    ))
  }
</div>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .tool-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: rgba(17, 24, 39, 0.75);
  }
  .tool-card.available {
    border-color: var(--sl-color-accent);
  }
  .tool-card.coming-soon {
    opacity: 0.75;
  }
  .tool-card h3 {
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  .tool-card p {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .latest {
    color: var(--sl-color-gray-2);
  }
  .zh-name {
    color: var(--sl-color-accent-high);
  }
</style>
