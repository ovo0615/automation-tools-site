---
import { toolList, toolData } from '../lib/data';
import { url } from '../lib/url';
const available = toolList.filter(t => t.status === 'available');
const upcoming = toolList.filter(t => t.status !== 'available');
const image = 'https://raw.githubusercontent.com/ovo0615/pcb-si-3d-simulation-toolkit/1d27b28bb9dbbd26b3dfe634b17632a647b9a6ed/graph/gui-15b-segment-overlays.png';
---

<section class="tool-catalog not-content" aria-label="Tools · 工具一覽">
  {
    available.map((t) => (
      <article class="featured-tool">
        <div class="tool-copy">
        <h2><a href={url(`/tools/${t.slug}/`)}>{t.name}</a></h2>
        <p class="tool-name" lang="zh-Hant">{t.nameZh}</p>
        <p>{t.summary}</p>
        <p class="zh" lang="zh-Hant">{t.summaryZh}</p>
        <p class="release-meta">Available · 已推出</p>
        {toolData(t.slug)?.sections[0] && (
          <p class="release-meta">
            Latest · 最新版本：<a href={url(`/tools/${t.slug}/changelog/`)}>{toolData(t.slug)!.sections[0].version}</a>
          </p>
        )}
        </div>
        {t.slug === 'pcb-si' && <figure>
          <a href={url('/tools/pcb-si/')} aria-label="Explore PCB SI segmentation · 查看 PCB SI 分段功能">
            <img class="shot" src={image} width="994" height="630" alt="PCB channel segmentation preview with cut points and no-cut zones" loading="lazy" decoding="async" />
          </a>
          <figcaption>Channel segmentation · 通道分段預覽</figcaption>
        </figure>}
      </article>
    ))
  }
  <section class="upcoming" aria-labelledby="upcoming-title">
    <h2 id="upcoming-title">Coming soon · 即將推出</h2>
    <ul>{upcoming.map(t => <li><strong>{t.name}</strong><span lang="zh-Hant">{t.nameZh}</span></li>)}</ul>
  </section>
</section>

<style>
  .tool-catalog { margin-block: 2.5rem; }
  .featured-tool {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 2.5rem;
    padding-block: 2rem;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  .tool-copy { min-width: 0; }
  h2 { margin: 0; font-size: 1.75rem; line-height: 1.25; }
  h2 a { color: var(--sl-color-white); }
  p { margin: 1rem 0 0; }
  .tool-name { margin-top: 0.5rem; color: var(--sl-color-gray-2); }
  .release-meta { font-size: 0.875rem; color: var(--sl-color-gray-3); }
  figure { margin: 0; }
  figcaption { margin-top: 0.5rem; font-size: 0.875rem; color: var(--sl-color-gray-3); }
  .upcoming { margin-top: 2rem; }
  .upcoming h2 { font-size: 1.125rem; }
  ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  li { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-block: 0.75rem; border-bottom: 1px solid var(--sl-color-gray-5); }
  li strong { flex: 1 1 18rem; font-weight: 400; }
  li span { flex: 1 1 18rem; color: var(--sl-color-gray-3); }
  @media (max-width: 48rem) {
    .featured-tool { grid-template-columns: 1fr; gap: 1.5rem; }
    h2 { font-size: 1.5rem; }
  }
</style>
