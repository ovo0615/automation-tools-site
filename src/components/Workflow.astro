---
// 首頁工作流程：依工具的分組排列，圖示與工具入口畫面相同；每一步連到快速開始對應章節。
import FeatureIcon from './FeatureIcon.astro';
import { groups, type Group } from '../lib/pcbsi';
import { url } from '../lib/url';

type Step = { icons: string[]; zh: string; en: string; hash: string };
const flow: { group: Group; steps: Step[] }[] = [
  {
    group: 'prep',
    steps: [
      { icons: ['board'], zh: '載入板子', en: 'Load board', hash: '1-load-a-board--載入電路板' },
      { icons: ['cutout'], zh: '裁切', en: 'Cut out', hash: '3-preview-and-cut--預覽與裁切' },
    ],
  },
  {
    group: 'analysis',
    steps: [
      { icons: ['ports'], zh: 'Port', en: 'Ports', hash: '4-ports-and-frequency--port-與頻率' },
      { icons: ['segment'], zh: '分段', en: 'Segment', hash: '6-segment-the-channel--分段' },
      { icons: ['schedule'], zh: '排程', en: 'Schedule', hash: '7-assign-solvers-and-schedule--指定求解器與排程' },
    ],
  },
  {
    group: 'result',
    steps: [
      { icons: ['cascade'], zh: '串接', en: 'Cascade', hash: '8-cascade--電路串接' },
      { icons: ['sparam', 'eye', 'tdr'], zh: 'S 參數／眼圖／TDR', en: 'S-par · Eye · TDR', hash: '9-s-parameters--s-參數' },
      { icons: ['report'], zh: '報告', en: 'Report', hash: '12-html-report--一鍵-html-報告' },
    ],
  },
];
const manual = url('/tools/pcb-si/manual/');
---
<ol class="workflow" aria-label="PCB SI 3D Simulation Toolkit 工作流程">
  {flow.map(({ group, steps }) => (
    <li class="wf-group" data-group={group}>
      <span class="grp-tag">{groups[group].zh}</span>
      <ol class="wf-steps">
        {steps.map((step) => (
          <li class="wf-step">
            <a href={`${manual}#${step.hash}`}>
              <span class="wf-icons">
                {step.icons.map((name) => <FeatureIcon name={name} group={group} size={step.icons.length > 1 ? 30 : 44} />)}
              </span>
              <span class="wf-zh">{step.zh}</span>
              <span class="wf-en" lang="en">{step.en}</span>
            </a>
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>
<p class="wf-optional" data-group="pre">
  <span class="grp-tag">{groups.pre.zh}</span>
  <FeatureIcon name="backdrill" group="pre" size={28} /><FeatureIcon name="cleanup" group="pre" size={28} />
  <span>裁切後可加做背鑽與 Layout 清理（Beta）。</span>
</p>

<style>
  .workflow, .wf-steps { list-style: none; margin: 0; padding: 0; }
  .workflow {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 0;
    margin-block: 1.5rem 0.75rem;
    max-width: 960px;
  }
  .workflow > li { margin: 0; }
  .wf-group {
    flex: 1 1 auto;
    border-top: 2px solid var(--grp-color);
    padding-top: 0.375rem;
  }
  .wf-group + .wf-group { margin-inline-start: 0.25rem; }
  .wf-steps { display: flex; margin-top: 0.5rem; }
  .wf-step { position: relative; flex: 1 1 0; min-width: 6.25rem; margin: 0; padding-inline: 1.25rem 0.25rem; }
  .wf-group:first-child .wf-step:first-child { padding-inline-start: 0; }
  /* 步驟之間的細線箭頭，對齊圖示中線 */
  .wf-step::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 22px;
    width: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-4);
  }
  .wf-step::after {
    content: '';
    position: absolute;
    left: calc(0.25rem + 0.75rem - 5px);
    top: 19px;
    border: 3px solid transparent;
    border-left: 5px solid var(--sl-color-gray-4);
    border-right: 0;
  }
  .wf-group:first-child .wf-step:first-child::before,
  .wf-group:first-child .wf-step:first-child::after { display: none; }
  .wf-step a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .wf-step a:hover .wf-zh { color: var(--sl-color-accent-high); text-decoration: underline; }
  .wf-icons { display: flex; gap: 3px; align-items: center; min-height: 44px; }
  .wf-zh { font-weight: 650; line-height: 1.35; }
  .wf-en { color: var(--sl-color-gray-3); font-size: 0.8125rem; line-height: 1.3; }
  .grp-tag {
    color: var(--grp-text);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .wf-optional {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin: 1rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--grp-color);
    max-width: 72ch;
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
  }
  .wf-optional .grp-tag { margin-inline-end: 0.25rem; }

  /* 窄螢幕改直排：每組一段，步驟由上往下 */
  @media (max-width: 40rem) {
    .workflow { flex-direction: column; gap: 1.25rem; }
    .wf-group + .wf-group { margin-inline-start: 0; }
    .wf-steps { flex-direction: column; }
    .wf-step, .wf-group:first-child .wf-step:first-child { padding: 0.5rem 0 0.5rem 0; min-width: 0; }
    .wf-step a { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
    .wf-icons { min-width: 44px; }
    .wf-step::before { left: 21px; top: -0.375rem; width: 0; height: 0.75rem; border-top: 0; border-left: 1px solid var(--sl-color-gray-4); }
    .wf-step::after { display: none; }
    .wf-step:first-child::before { display: none; }
  }
</style>
